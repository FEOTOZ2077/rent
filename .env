VITE_SUPABASE_URL=https://zdwhdoazubrchboeyllh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tSl14p9Whn2fMYHaRA7unw_rYfiXpqXimport { ref, reactive } from 'vue'
const supabaseUrl = 'https://zdwhdoazubrchboeyllh.supabase.co'
const supabaseAnonKey = 'sb_publishable_tSl14p9Whn2fMYHaRA7unw_rYfiXpqX'
import { createClient } from '@supabase/supabase-js'

const supabaseUrl = 'https://xxxxxxxxxxxxxx.supabase.co'
const supabaseAnonKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxx'

export const supabase = createClient(supabaseUrl, supabaseAnonKey)

const isAuthenticated = ref(false)
const user = reactive({
  id: '', name: '', username: '', email: '', role: 'user', avatar: ''
})

export function useAuth() {
  
  const setUserData = (supabaseUser) => {
    if (!supabaseUser) return

    isAuthenticated.value = true
    user.id = supabaseUser.id
    user.email = supabaseUser.email
    user.username = supabaseUser.user_metadata?.username || ''
    
    const firstName = supabaseUser.user_metadata?.first_name || ''
    const lastName = supabaseUser.user_metadata?.last_name || ''
    
    user.name = firstName ? `${firstName} ${lastName}` : user.username
    user.role = supabaseUser.user_metadata?.role || 'user'
    user.avatar = `https://ui-avatars.com/api/?name=${user.name}&background=4f46e5&color=fff`
  }

  const clearUserData = () => {
    isAuthenticated.value = false
    Object.assign(user, { id: '', name: '', username: '', email: '', role: 'user', avatar: '' })
  }

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) setUserData(session.user)
  })

  supabase.auth.onAuthStateChange((_event, session) => {
    if (session) setUserData(session.user)
    else clearUserData()
  })

  // 🟢 1. สมัครสมาชิก (เพิ่ม Username ลงไป)
  const registerUser = async (userData) => {
    // เช็คก่อนว่า Username ซ้ำไหม
    const { data: existingUser } = await supabase.from('profiles').select('username').eq('username', userData.username).single()
    if (existingUser) throw new Error('ชื่อผู้ใช้งาน (Username) นี้ถูกใช้ไปแล้ว กรุณาใช้ชื่ออื่น')

    const { data, error } = await supabase.auth.signUp({
      email: userData.email,
      password: userData.password,
      options: {
        data: {
          username: userData.username, // ส่ง username ไปเก็บ
          first_name: userData.firstName,
          last_name: userData.lastName,
          role: 'user'
        }
      }
    })

    if (error) throw new Error(error.message)
    return data
  }

  // 🟢 2. ล็อกอิน (รองรับทั้ง Email และ Username)
  const login = async (credentials) => {
    let loginEmail = credentials.identifier // identifier คือค่าที่รับมาจากฟอร์ม

    // ถ้าไม่มีตัว @ แสดงว่าเป็น Username
    if (!loginEmail.includes('@')) {
      const { data, error } = await supabase.from('profiles').select('email').eq('username', loginEmail).single()
      
      if (error || !data) throw new Error('ไม่พบชื่อผู้ใช้งานนี้ในระบบ')
      loginEmail = data.email // นำ Email ที่เจอมาใช้ล็อกอินต่อ
    }

    const { data, error } = await supabase.auth.signInWithPassword({
      email: loginEmail,
      password: credentials.password
    })

    if (error) throw new Error('อีเมล/ชื่อผู้ใช้งาน หรือ รหัสผ่าน ไม่ถูกต้อง')
    return data
  }

  const logout = async () => {
    await supabase.auth.signOut()
  }

  const setRole = async (role) => {
    const { error } = await supabase.auth.updateUser({ data: { role: role } })
    if (!error) user.role = role
  }

  return { isAuthenticated, user, registerUser, login, logout, setRole }
}